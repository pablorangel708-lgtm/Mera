-- 9) WATER AURA
-- ===================================================================================
local Aura = { sess = nil, wanted = false }

function Aura.start()
	if Aura.sess then
		return
	end
	local ch = player.Character
	local hrp = getHRP(ch)
	if not (ch and hrp and isAlive(ch)) then
		return
	end
	Aura.wanted = true
	local s = newSession()
	Aura.sess = s
	s.t0 = os.clock()
	s.form = 0
	s.dis = 0
	s.lastRipple = 0
	s.maid:Give(function()
		if Aura.sess == s then
			Aura.sess = nil
		end
		UI.refresh()
	end)
	local core = s.maid:Give(fxPart({ Size = Vector3.new(3, 5.5, 3), Transparency = 1 }))
	new("PointLight", { Color = C.Turquoise, Brightness = 0.6, Range = 9 }, core)
	emitter(core, { Size = 0.28, Rate = 8, Speed0 = 1.5, Speed1 = 3.5, Spread = 25, Accel = Vector3.new(0, 1, 0), Life0 = 0.9, Life1 = 1.6, Light = 0.8, Shape = Enum.ParticleEmitterShape.Cylinder })
	emitter(core, { Texture = TEX_SMOKE, Size = 2.2, T0 = 0.75, Rate = 4, Speed0 = 0.3, Speed1 = 1, Life0 = 1, Life1 = 1.6, Light = 0.4, Color0 = C.Light, Color1 = C.Ocean, Shape = Enum.ParticleEmitterShape.Cylinder })
	local hl = new("Highlight", {
		Adornee = ch, FillColor = C.Turquoise, OutlineColor = C.Light, FillTransparency = 1, OutlineTransparency = 1,
		DepthMode = Enum.HighlightDepthMode.Occluded,
	}, fxFolder)
	s.maid:Give(hl)
	local orbs = {}
	for i = 1, math.max(3, math.floor(6 * Q + 0.5)) do
		local o = s.maid:Give(orbiter(0.35, 0.45))
		orbs[i] = { part = o, a = i * 1.1, h = -1.8 + (i % 4) * 1.4, spd = 1.8 + (i % 3) * 0.6, r = 2.4 + (i % 2) * 0.5 }
	end
	pulsePose("focus", 1.0)
	animate(s, 0.7, function(a)
		s.form = easeOut(a)
	end)
	UI.notify("Water Aura ativada.")

	addUpdater(s, function(dt)
		local hrp2 = getHRP()
		if not hrp2 then
			return
		end
		local t = os.clock() - s.t0
		local fade = s.form * (1 - s.dis)
		core.CFrame = hrp2.CFrame
		hl.FillTransparency = 1 - (0.14 + 0.05 * math.sin(t * 2.4)) * fade
		hl.OutlineTransparency = 1 - 0.45 * fade
		for _, o in ipairs(orbs) do
			local ang = o.a + t * o.spd
			o.part.CFrame = hrp2.CFrame * CFrame.new(math.cos(ang) * o.r, o.h + math.sin(t * 2 + o.a) * 0.3, math.sin(ang) * o.r)
			o.part.Transparency = 1 - 0.75 * fade
		end
		if os.clock() - s.lastRipple > 0.9 then
			s.lastRipple = os.clock()
			local hum = getHum(player.Character)
			if hum and hum.FloorMaterial ~= Enum.Material.Air and fade > 0.5 then
				local gy = groundAt(hrp2.Position, 0)
				ring(Vector3.new(hrp2.Position.X, gy + 0.1, hrp2.Position.Z), 3.2, nil, C.Light, 0.9)
			end
		end
	end)
	UI.refresh()
end

-- encerra a sessão visual; "keepWanted" preserva a vontade de religar após respawn
function Aura.suspend()
	local s = Aura.sess
	if s then
		s:End()
	end
end

function Aura.stop(instant)
	Aura.wanted = false
	local s = Aura.sess
	if not s then
		UI.refresh()
		return
	end
	if instant then
		s:End()
		return
	end
	if s.closing then
		return
	end
	s.closing = true
	animate(s, 0.5, function(a)
		s.dis = a
	end, function()
		s:End()
	end)
	UI.refresh()
end

