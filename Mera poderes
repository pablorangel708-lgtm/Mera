-- 3) WATER WHIP
-- ===================================================================================
local Whip = { sess = nil }

function Whip.start()
	if Whip.sess then
		return
	end
	local ch = player.Character
	if not isAlive(ch) then
		return
	end
	local WN = CONFIG.Whip.Segments
	local s = newSession()
	Whip.sess = s
	s.t0 = os.clock()
	s.state = "idle"
	s.maid:Give(function()
		if Whip.sess == s then
			Whip.sess = nil
		end
		setBasePose("whip", nil)
		UI.refresh()
	end)
	s.whips = {}
	for _, side in ipairs({ "R", "L" }) do
		local w = { side = side, att = {}, len = 0, lenGoal = 13, amp = 0.5, ampGoal = 1.3, spd = 5, spdGoal = 5, k = 7, ph = side == "L" and 1.9 or 0 }
		for i = 1, WN do
			local a = new("Attachment", nil, Workspace.Terrain)
			s.maid:Give(a)
			w.att[i] = a
		end
		for i = 1, WN - 1 do
			local u0, u1 = (i - 1) / (WN - 1), i / (WN - 1)
			local b = new("Beam", {
				Attachment0 = w.att[i], Attachment1 = w.att[i + 1],
				Width0 = 0.15 + 0.55 * (1 - u0) ^ 1.2, Width1 = 0.15 + 0.55 * (1 - u1) ^ 1.2,
				Color = ColorSequence.new(C.Light:Lerp(C.Turquoise, u0), C.Light:Lerp(C.Turquoise, u1)),
				Transparency = NumberSequence.new(0.2 + 0.4 * u0, 0.2 + 0.4 * u1),
				LightEmission = 0.55, Segments = 1, FaceCamera = true,
			}, fxFolder)
			s.maid:Give(b)
		end
		w.tip = s.maid:Give(fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, Material = Enum.Material.Neon, Color = C.Foam, Transparency = 0.3 }))
		emitter(w.tip, { Size = 0.3, Rate = 40, Speed0 = 2, Speed1 = 6, Accel = Vector3.new(0, -20, 0), Life0 = 0.3, Life1 = 0.7 })
		emitter(w.att[1], { Size = 0.3, Rate = 25, Speed0 = 1, Speed1 = 3, Life0 = 0.3, Life1 = 0.6, Accel = Vector3.new(0, -6, 0) })
		table.insert(s.whips, w)
	end
	setBasePose("whip", "whip")
	pulsePose("whipWind", 0.5)
	UI.notify("Water Whip ativado.")

	addUpdater(s, function(dt)
		local hrp = getHRP()
		if not hrp then
			s:End()
			return
		end
		local t = os.clock() - s.t0
		local range = CONFIG.Whip.Range
		local aim = getAimPos(range)
		local rv = hrp.CFrame.RightVector
		for _, w in ipairs(s.whips) do
			local hand = handPos(w.side) or hrp.Position
			local kk = 1 - math.exp(-dt * w.k)
			local sideSign = (w.side == "R") and 1 or -1
			local aimW = aim + rv * sideSign * (s.state == "lash" and 0.8 or 3)
			local v = aimW - hand
			local dist = v.Magnitude
			if s.state == "lash" then
				w.lenGoal = math.min(dist, range)
			end
			w.len = w.len + (w.lenGoal - w.len) * kk
			w.amp = w.amp + (w.ampGoal - w.amp) * kk
			w.spd = w.spd + (w.spdGoal - w.spd) * kk
			local dir = dist > 0.05 and v / dist or hrp.CFrame.LookVector
			local length = math.min(w.len, math.max(dist, 2))
			local p1 = dir:Cross(Vector3.yAxis)
			if p1.Magnitude < 0.05 then
				p1 = dir:Cross(Vector3.xAxis)
			end
			p1 = p1.Unit
			local p2 = dir:Cross(p1)
			local last = hand
			for i = 1, #w.att do
				local u = (i - 1) / (#w.att - 1)
				local env = math.sin(math.pi * u) ^ 0.7
				local phase = u * 3.2 * math.pi * 2 - t * w.spd + w.ph
				local off = (p1 * math.sin(phase) + p2 * math.cos(phase)) * w.amp * env * (0.3 + 0.7 * math.min(length / 10, 1))
				last = hand + dir * (length * u) + off
				w.att[i].WorldPosition = last
			end
			w.tip.CFrame = CFrame.new(last)
			w.tip.Transparency = (s.closing and w.len < 0.5) and 1 or 0.3
		end
	end)
	UI.refresh()
end

function Whip.attack()
	if not Whip.sess then
		Whip.start()
	end
	local s = Whip.sess
	if not s or s.busy or s.closing then
		return
	end
	if not tryUse("WhipAttack") then
		return
	end
	s.busy = true
	local function goals(len, amp, spd, k)
		for _, w in ipairs(s.whips) do
			w.lenGoal, w.ampGoal, w.spdGoal, w.k = len, amp, spd, k
		end
	end
	task.spawn(function()
		s.state = "prep"
		goals(4.5, 2.6, 10, 9)
		pulsePose("whipWind", 0.5)
		if not swait(s, 0.38) then
			return
		end
		s.state = "lash"
		goals(0, 0.25, 34, 24)
		pulsePose("whip", 0.5)
		if not swait(s, 0.2) then
			return
		end
		local tip = s.whips[1].tip.Position
		splash(tip, nil, 1.2)
		shake(1.4, 0.35)
		pulsePose("whipPull", 0.5)
		for _, w in ipairs(s.whips) do
			burst(w.tip.Position, 20)
		end
		s.state = "pull"
		goals(2.5, 1.8, 12, 12)
		if not swait(s, 0.45) then
			return
		end
		s.state = "idle"
		goals(13, 1.3, 5, 7)
		s.busy = false
	end)
end

function Whip.stop(instant)
	local s = Whip.sess
	if not s then
		return
	end
	if instant then
		s:End()
		return
	end
	if s.closing then
		return
	end
	s.closing = true
	s.state = "close"
	for _, w in ipairs(s.whips) do
		w.lenGoal, w.ampGoal, w.spdGoal, w.k = 0, 0.4, 12, 10
		burst(w.tip.Position, 14)
	end
	animate(s, 0.5, function() end, function()
		s:End()
	end)
end

