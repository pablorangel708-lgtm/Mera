-- ===================================================================================
local Constructs = { sess = nil, armed = false }
local WEAPONS = {
	sword = { rest = -38, len = 5.9 },
	spear = { rest = -80, len = 8.0 },
	trident = { rest = -80, len = 8.3 },
}

local function buildWeapon(s, kind)
	s.parts, s.emitters = {}, {}
	local function wp(size, off, props)
		props = props or {}
		local p = fxPart({
			Size = size * 0.05, Color = props.Color or C.Ocean, Material = props.Material or Enum.Material.Glass, Transparency = 1,
		})
		if props.Mesh then
			new("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, p)
		end
		s.maid:Give(p)
		table.insert(s.parts, { part = p, off = off, size = size, tr = props.Transparency or 0.5 })
		return p
	end
	local neon = Enum.Material.Neon
	if kind == "sword" then
		local blade = wp(Vector3.new(0.55, 4.6, 0.14), CFrame.new(0, 3.2, 0), { Color = C.Light, Transparency = 0.45 })
		wp(Vector3.new(0.2, 4.5, 0.17), CFrame.new(0, 3.2, 0), { Color = C.Foam, Material = neon, Transparency = 0.55 })
		wp(Vector3.new(0.55, 1.4, 0.14), CFrame.new(0, 5.7, 0), { Color = C.Light, Transparency = 0.45, Mesh = true })
		wp(Vector3.new(2.1, 0.28, 0.45), CFrame.new(0, 0.85, 0), { Color = C.Turquoise, Transparency = 0.3 })
		wp(Vector3.new(0.28, 1.3, 0.28), CFrame.new(0, 0.05, 0), { Color = C.Navy, Transparency = 0.2 })
		wp(Vector3.new(0.55, 0.55, 0.55), CFrame.new(0, -0.7, 0), { Color = C.Turquoise, Material = neon, Transparency = 0.2, Mesh = true })
		table.insert(s.emitters, emitter(blade, { Size = 0.25, Rate = 14, Speed0 = 0, Speed1 = 1, Accel = Vector3.new(0, -8, 0), Life0 = 0.5, Life1 = 1 }))
	elseif kind == "spear" then
		local shaft = wp(Vector3.new(0.22, 7, 0.22), CFrame.new(0, 2.8, 0), { Color = C.Ocean, Transparency = 0.4 })
		wp(Vector3.new(0.7, 2.2, 0.28), CFrame.new(0, 7.0, 0), { Color = C.Light, Transparency = 0.4, Mesh = true })
		wp(Vector3.new(0.3, 1.8, 0.12), CFrame.new(0, 7.0, 0), { Color = C.Foam, Material = neon, Transparency = 0.5, Mesh = true })
		wp(Vector3.new(0.5, 0.35, 0.5), CFrame.new(0, 5.8, 0), { Color = C.Turquoise, Material = neon, Transparency = 0.3 })
		wp(Vector3.new(0.4, 0.4, 0.4), CFrame.new(0, -0.9, 0), { Color = C.Turquoise, Material = neon, Transparency = 0.2, Mesh = true })
		table.insert(s.emitters, emitter(shaft, { Size = 0.25, Rate = 12, Speed0 = 0, Speed1 = 1, Accel = Vector3.new(0, -8, 0), Life0 = 0.5, Life1 = 1 }))
	else
		local shaft = wp(Vector3.new(0.2, 6.2, 0.2), CFrame.new(0, 2.6, 0), { Color = C.Ocean, Transparency = 0.4 })
		wp(Vector3.new(1.9, 0.22, 0.22), CFrame.new(0, 5.4, 0), { Color = C.Turquoise, Transparency = 0.3 })
		wp(Vector3.new(0.18, 1.8, 0.18), CFrame.new(0, 6.5, 0), { Color = C.Light, Transparency = 0.4 })
		wp(Vector3.new(0.45, 1.4, 0.2), CFrame.new(0, 7.6, 0), { Color = C.Light, Transparency = 0.35, Mesh = true })
		for _, x in ipairs({ -0.85, 0.85 }) do
			wp(Vector3.new(0.16, 1.5, 0.16), CFrame.new(x, 6.2, 0), { Color = C.Light, Transparency = 0.4 })
			wp(Vector3.new(0.4, 1.2, 0.18), CFrame.new(x, 7.2, 0), { Color = C.Light, Transparency = 0.35, Mesh = true })
		end
		wp(Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, -0.8, 0), { Color = C.Turquoise, Material = neon, Transparency = 0.2, Mesh = true })
		table.insert(s.emitters, emitter(shaft, { Size = 0.25, Rate = 12, Speed0 = 0, Speed1 = 1, Accel = Vector3.new(0, -8, 0), Life0 = 0.5, Life1 = 1 }))
	end
end

function Constructs.arm()
	if Constructs.armed then
		return
	end
	if not isAlive(player.Character) then
		return
	end
	Constructs.armed = true
	UI.notify("Water Constructs: escolha uma arma.")
	UI.refresh()
end

function Constructs.dissolve(s, instant)
	if not s or s.closing then
		return
	end
	s.closing = true
	if instant then
		s:End()
		return
	end
	for _, d in ipairs(s.parts) do
		tw(d.part, 0.35, { Transparency = 1, Size = d.size * 0.05 })
		burst(d.part.Position, 3, { Size = 0.3 })
	end
	animate(s, 0.4, function() end, function()
		s:End()
	end)
end

function Constructs.equip(kind)
	if not Constructs.armed then
		Constructs.arm()
	end
	if not Constructs.armed then
		return
	end
	local cur = Constructs.sess
	if cur and not cur.closing then
		local same = cur.kind == kind
		Constructs.dissolve(cur, false)
		if same then
			Constructs.sess = nil
			UI.refresh()
			return
		end
	end
	local ch = player.Character
	if not isAlive(ch) then
		return
	end
	local s = newSession()
	Constructs.sess = s
	s.kind = kind
	s.t0 = os.clock()
	s.lastTrail = 0
	buildWeapon(s, kind)
	s.maid:Give(function()
		if Constructs.sess == s then
			Constructs.sess = nil
		end
		if not Constructs.sess then
			setBasePose("weapon", nil)
		end
		UI.refresh()
	end)
	setBasePose("weapon", "hold")
	pulsePose("summon", 0.6)
	local hp0 = handPos("R")
	if hp0 then
		burst(hp0, 30, { Size = 0.4 })
		ring(hp0, 2.5, nil, C.Light, 0.5)
	end
	for i, d in ipairs(s.parts) do
		TweenService:Create(d.part, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, i * 0.04), { Size = d.size, Transparency = d.tr }):Play()
	end
	addUpdater(s, function(dt)
		local hrp = getHRP()
		local hp = handPos("R")
		if not hrp or not hp then
			return
		end
		local W = WEAPONS[kind]
		local rot = hrp.CFrame - hrp.CFrame.Position
		local t = os.clock() - s.t0
		local rest = math.rad(W.rest)
		local pitch = rest + math.sin(t * 1.7) * 0.04
		local thrust = 0
		if s.atk then
			local a = math.clamp((os.clock() - s.atk.t0) / s.atk.dur, 0, 1)
			if kind == "sword" then
				if a < 0.3 then
					pitch = lerp(rest, math.rad(55), easeOut(a / 0.3))
				else
					pitch = lerp(math.rad(55), math.rad(-150), easeOut((a - 0.3) / 0.7))
				end
			else
				thrust = math.sin(math.pi * a) * 3.6
			end
			local grip0 = CFrame.new(hp) * rot * CFrame.Angles(pitch, 0, 0) * CFrame.new(0, thrust - 0.2, 0)
			local tipPos = (grip0 * CFrame.new(0, W.len, 0)).Position
			if os.clock() - s.lastTrail > 0.04 then
				s.lastTrail = os.clock()
				burst(tipPos, 4, { Size = 0.3 })
			end
			if not s.atk.hit and a >= 0.7 then
				s.atk.hit = true
				splash(tipPos, nil, 1)
				shake(0.8, 0.2)
			end
			if a >= 1 then
				s.atk = nil
				for _, e in ipairs(s.emitters) do
					e.Rate = 14 * Q
				end
			end
		end
		local grip = CFrame.new(hp) * rot * CFrame.Angles(pitch, 0, 0) * CFrame.new(0, thrust - 0.2, 0)
		for _, d in ipairs(s.parts) do
			d.part.CFrame = grip * d.off
		end
	end)
	UI.refresh()
end

function Constructs.attack()
	local s = Constructs.sess
	if not s or s.closing then
		UI.notify("Escolha uma arma primeiro.")
		return
	end
	if s.atk then
		return
	end
	if not tryUse("WeaponAttack", true) then
		return
	end
	local dur = (s.kind == "sword") and 0.55 or 0.5
	s.atk = { t0 = os.clock(), dur = dur }
	pulsePose(s.kind == "sword" and "slash" or "thrust", dur + 0.1)
	for _, e in ipairs(s.emitters) do
		e.Rate = 90 * Q
	end
end

function Constructs.disarm(instant)
	Constructs.armed = false
	local s = Constructs.sess
	if s then
		Constructs.dissolve(s, instant)
	end
	if instant then
		Constructs.sess = nil
		setBasePose("weapon", nil)
	end
	UI.refresh()
end

