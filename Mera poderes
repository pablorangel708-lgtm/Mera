local function fxPart(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Massless = true
	p.Material = Enum.Material.Glass
	p.Color = C.Ocean
	p.Transparency = 0.5
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent or fxFolder
	return p
end

local function emitter(parent, o)
	local e = Instance.new("ParticleEmitter")
	e.Texture = o.Texture or TEX_SPARK
	e.Color = ColorSequence.new(o.Color0 or C.Foam, o.Color1 or C.Turquoise)
	e.LightEmission = o.Light or 0.6
	e.LightInfluence = 0
	local s0 = o.Size or 0.4
	e.Size = NumberSequence.new({ kp(0, s0), kp(0.4, s0 * (o.Grow or 1)), kp(1, 0) })
	e.Transparency = NumberSequence.new({ kp(0, o.T0 or 0.15), kp(1, 1) })
	e.Lifetime = NumberRange.new(o.Life0 or 0.5, o.Life1 or 1)
	e.Speed = NumberRange.new(o.Speed0 or 1, o.Speed1 or 3)
	e.SpreadAngle = Vector2.new(o.Spread or 180, o.Spread or 180)
	e.Acceleration = o.Accel or Vector3.zero
	e.Drag = o.Drag or 0
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Rotation = NumberRange.new(0, 360)
	e.EmissionDirection = o.Dir or Enum.NormalId.Top
	e.Rate = (o.Rate or 0) * Q
	if o.Enabled ~= nil then
		e.Enabled = o.Enabled
	else
		e.Enabled = (o.Rate or 0) > 0
	end
	if o.Shape then
		e.Shape = o.Shape
		e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	end
	e.Parent = parent
	return e
end

local function burst(pos, count, o)
	o = o or {}
	local p = fxPart({ Size = Vector3.one * 0.2, Transparency = 1, CFrame = CFrame.new(pos) })
	local e = emitter(p, {
		Texture = o.Texture, Size = o.Size or 0.5, Speed0 = o.Speed0 or 7, Speed1 = o.Speed1 or 18,
		Accel = Vector3.new(0, -32, 0), Life0 = 0.5, Life1 = 1.1, Light = 0.5, Enabled = false,
	})
	e:Emit(math.max(1, math.floor(count * Q)))
	local m = emitter(p, {
		Texture = TEX_SMOKE, Size = 2.2, Grow = 1.5, T0 = 0.55, Speed0 = 2, Speed1 = 8,
		Life0 = 0.4, Life1 = 0.9, Light = 0.3, Enabled = false, Color0 = C.Foam, Color1 = C.Light,
	})
	m:Emit(math.max(1, math.floor(count * Q * 0.25)))
	Debris:AddItem(p, 2)
	return p
end

local function ring(pos, radius, normal, color, life)
	normal = normal or Vector3.yAxis
	life = life or 0.6
	local up = math.abs(normal.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
	local cf = CFrame.lookAt(pos, pos + normal, up) * CFrame.Angles(0, math.rad(90), 0)
	local p = fxPart({
		Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 0.5, 0.5), CFrame = cf,
		Material = Enum.Material.Neon, Color = color or C.Light, Transparency = 0.25,
	})
	tw(p, life, { Size = Vector3.new(0.12, radius * 2, radius * 2), Transparency = 1 })
	Debris:AddItem(p, life + 0.1)
	return p
end

local function splash(pos, normal, scale)
	scale = scale or 1
	burst(pos, 26 * scale, { Size = 0.45, Speed0 = 6 * scale, Speed1 = 16 * scale })
	ring(pos + (normal or Vector3.yAxis) * 0.1, 3.5 * scale, normal)
end

-- Orbitador: pequena gota com rastro luminoso
local function orbiter(size, life)
	local p = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size, Material = Enum.Material.Neon, Color = C.Light, Transparency = 0.25 })
	local a0 = new("Attachment", { Position = Vector3.new(0, size * 0.9, 0) }, p)
	local a1 = new("Attachment", { Position = Vector3.new(0, -size * 0.9, 0) }, p)
	new("Trail", {
		Attachment0 = a0, Attachment1 = a1, Lifetime = life or 0.45, LightEmission = 0.7, FaceCamera = true,
		Color = ColorSequence.new(C.Foam, C.Turquoise),
		Transparency = NumberSequence.new({ kp(0, 0.2), kp(1, 1) }),
		WidthScale = NumberSequence.new({ kp(0, 1), kp(1, 0) }),
	}, p)
	return p
end

