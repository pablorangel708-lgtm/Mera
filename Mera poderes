local UI = { notify = function() end, refresh = function() end } -- preenchido mais abaixo

local function new(class, props, parent)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			o[k] = v
		end
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function lerp(a, b, t)
	return a + (b - a) * t
end
local function easeOut(x)
	return 1 - (1 - x) ^ 3
end
local function easeOutBack(x)
	local c1 = 1.70158
	local c3 = c1 + 1
	return 1 + c3 * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
end
local function rnd(a, b)
	return a + math.random() * (b - a)
end
local function tw(inst, t, props, style, dir)
	local tween = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

-- Maid: agrupa conexões, instâncias e funções para limpeza segura
local Maid = {}
Maid.__index = Maid
function Maid.new()
	return setmetatable({ items = {} }, Maid)
end
function Maid:Give(x)
	table.insert(self.items, x)
	return x
end
function Maid:Clean()
	for i = #self.items, 1, -1 do
		local it = self.items[i]
		self.items[i] = nil
		local ty = typeof(it)
		if ty == "RBXScriptConnection" then
			it:Disconnect()
		elseif ty == "Instance" then
			pcall(it.Destroy, it)
		elseif ty == "function" then
			pcall(it)
		elseif ty == "table" and it.Destroy then
			pcall(it.Destroy, it)
		end
	end
end
Maid.Destroy = Maid.Clean

local function newSession()
	local s = { alive = true, maid = Maid.new() }
	function s:End()
		if not self.alive then
			return
		end
		self.alive = false
		self.maid:Clean()
	end
	return s
end

