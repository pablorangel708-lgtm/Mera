-- 4) WATER BLAST
-- ===================================================================================
local Blast = { sess = nil, armed = false, mode = "bolt", stream = false }

function Blast.spawn(s, side, small)
	local hrp = getHRP()
	if not hrp then
		return
	end
	local origin = handPos(side) or hrp.Position
	local aim = getAimPos(180)
	local dir = aim - origin
	dir = dir.Magnitude > 0.5 and dir.Unit or hrp.CFrame.LookVector
	if small then
		dir = (dir + Vector3.new(rnd(-0.05, 0.05), rnd(-0.05, 0.05), rnd(-0.05, 0.05))).Unit
	end
	local size = small and 0.6 or 1.4
	local part = fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * size, Color = C.Turquoise, Transparency = 0.2, CFrame = CFrame.new(origin) })
	local a0 = new("Attachment", { Position = Vector3.new(0, size * 0.55, 0) }, part)
	local a1 = new("Attachment", { Position = Vector3.new(0, -size * 0.55, 0) }, part)
	new("Trail", {
		Attachment0 = a0, Attachment1 = a1, Lifetime = small and 0.25 or 0.4, LightEmission = 0.6, FaceCamera = true,
		Color = ColorSequence.new(C.Foam, C.Ocean), Transparency = NumberSequence.new({ kp(0, 0.2), kp(1, 1) }),
	}, part)
	emitter(part, { Size = 0.3, Rate = 45, Speed0 = 0, Speed1 = 2, Life0 = 0.3, Life1 = 0.6, Accel = Vector3.new(0, -8, 0) })
	local speed = small and CONFIG.Blast.JetSpeed or CONFIG.Blast.BoltSpeed
	table.insert(s.proj, { part = part, pos = origin, vel = dir * speed, grav = small and 6 or 14, life = 2.5, small = small })
	if #s.proj > CONFIG.Blast.MaxProjectiles then
		local old = table.remove(s.proj, 1)
		old.part:Destroy()
	end
	if not small then
		burst(origin, 10, { Size = 0.35 })
	end
end

function Blast.arm()
	if Blast.armed then
		return
	end
	if not isAlive(player.Character) then
		return
	end
	Blast.armed = true
	local s = newSession()
	Blast.sess = s
	s.proj, s.nextJet, s.side = {}, 0, "R"
	s.maid:Give(function()
		for _, p in ipairs(s.proj) do
			p.part:Destroy()
		end
		table.clear(s.proj)
		if Blast.sess == s then
			Blast.sess = nil
		end
		Blast.armed, Blast.stream = false, false
		setBasePose("blast", nil)
		UI.refresh()
	end)
	addUpdater(s, function(dt)
		if Blast.stream and Blast.mode == "jet" then
			local now = os.clock()
			if now >= s.nextJet then
				s.nextJet = now + CONFIG.Blast.JetInterval
				Blast.spawn(s, s.side, true)
				s.side = (s.side == "R") and "L" or "R"
			end
		end
		local params = ignoreList()
		for i = #s.proj, 1, -1 do
			local p = s.proj[i]
			p.life = p.life - dt
			p.vel = p.vel + Vector3.new(0, -p.grav, 0) * dt
			local nxt = p.pos + p.vel * dt
			local hit = Workspace:Raycast(p.pos, nxt - p.pos, params)
			if hit then
				splash(hit.Position, hit.Normal, p.small and 0.6 or 1.2)
				p.part:Destroy()
				table.remove(s.proj, i)
			elseif p.life <= 0 then
				burst(p.pos, 6, { Size = 0.3 })
				p.part:Destroy()
				table.remove(s.proj, i)
			else
				p.pos = nxt
				p.part.CFrame = CFrame.lookAt(nxt, nxt + p.vel)
			end
		end
	end)
	UI.notify("Water Blast armado.")
	UI.refresh()
end

function Blast.disarm()
	if Blast.sess then
		Blast.sess:End()
	end
	Blast.armed = false
	Blast.stream = false
	setBasePose("blast", nil)
	UI.refresh()
end

function Blast.setMode(m)
	Blast.mode = m
	if m ~= "jet" then
		Blast.setStream(false)
	end
	UI.refresh()
end

function Blast.setStream(on)
	if on and not Blast.armed then
		Blast.arm()
	end
	Blast.stream = on and Blast.armed
	setBasePose("blast", Blast.stream and "push" or nil)
end

function Blast.fire()
	if not Blast.armed then
		Blast.arm()
	end
	local s = Blast.sess
	if not s then
		return
	end
	if Blast.mode == "jet" then
		Blast.setStream(true)
		return
	end
	if not tryUse("Blast", true) then
		return
	end
	Blast.spawn(s, s.side, false)
	s.side = (s.side == "R") and "L" or "R"
	pulsePose("push", 0.3)
end

function Blast.stopJets()
	Blast.setStream(false)
	local s = Blast.sess
	if s then
		for _, p in ipairs(s.proj) do
			p.part:Destroy()
		end
		table.clear(s.proj)
	end
end

