local function holdBtn(parent, text, down, up, h)
	local b = btn(parent, text, nil, h)
	local holding = false
	b.InputBegan:Connect(function(i)
		if isPress(i) and not holding then
			holding = true
			down()
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					c:Disconnect()
					if holding then
						holding = false
						up()
					end
				end
			end)
		end
	end)
	return b
end

