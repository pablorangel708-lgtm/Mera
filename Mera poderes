-- 6) WATER SHIELD
-- ===================================================================================
local Shield = { sess = nil, scale = 1 }

function Shield.start()
	if Shield.sess then
		return
	end
	local ch = player.Character
	if not isAlive(ch) then
		return
	end
	local N = 9
	local s = newSession()
	Shield.sess = s
	s.t0 = os.clock()
	s.form, s.dis, s.cur = 0, 0, Shield.scale
	s.lastScan, s.lastHit = 0, 0
	s.panels = {}
	s.maid:Give(function()
		if Shield.sess == s then
			Shield.sess = nil
		end
		setBasePose("shield", nil)
		UI.refresh()
	end)
	for i = 1, N do
		local glass = s.maid:Give(fxPart({ Size = Vector3.new(1, 1, 0.25), Color = C.Ocean, Transparency = 1 }))
		local ff = s.maid:Give(fxPart({ Size = Vector3.new(1, 1, 0.4), Color = C.Turquoise, Material = Enum.Material.ForceField, Transparency = 1 }))
		if i % 2 == 1 then
			emitter(glass, { Size = 0.28, Rate = 7, Speed0 = 0.5, Speed1 = 2, Accel = Vector3.new(0, -4, 0), Life0 = 0.6, Life1 = 1.1 })
		end
		s.panels[i] = { glass = glass, ff = ff, a = math.rad(lerp(-55, 55, (i - 1) / (N - 1))), flash = 0 }
	end
	local hrp0 = getHRP()
	if hrp0 then
		burst(hrp0.Position + hrp0.CFrame.LookVector * 5, 24)
	end
	pulsePose("summon", 0.8)
	setBasePose("shield", "shield")
	animate(s, 0.7, function(a)
		s.form = easeOut(a)
	end)
	UI.notify("Water Shield ativado.")

	addUpdater(s, function(dt)
		local hrp = getHRP()
		if not hrp then
			s:End()
			return
		end
		local now = os.clock()
		local t = now - s.t0
		s.cur = lerp(s.cur, Shield.scale, 1 - math.exp(-dt * 8))
		local radius = CONFIG.Shield.Radius * s.cur
		local fade = s.form * (1 - s.dis)
		local height = math.max(CONFIG.Shield.Height * s.cur * math.max(s.form, 0.02) * (1 - s.dis * 0.6), 0.1)
		local step = math.rad(110) / (N - 1)
		local chord = 2 * radius * math.sin(step / 2) * 1.12
		local base = hrp.CFrame * CFrame.new(0, height * 0.5 - 3, 0)
		for i, p in ipairs(s.panels) do
			local rel = CFrame.new(Vector3.new(math.sin(p.a), 0, -math.cos(p.a)) * radius) * CFrame.Angles(0, -p.a, 0)
			local cf = base * rel
			p.glass.CFrame = cf
			p.glass.Size = Vector3.new(chord, height, 0.25)
			p.ff.CFrame = cf
			p.ff.Size = Vector3.new(chord * 0.97, height * 0.97, 0.4)
			p.flash = math.max(0, p.flash - dt * 3)
			p.glass.Transparency = 1 - (0.42 + 0.06 * math.sin(t * 3 + i) + 0.4 * p.flash) * fade
			p.ff.Transparency = 1 - (0.5 + 0.2 * p.flash) * fade
		end
		-- impactos detectáveis localmente: peças soltas rápidas se aproximando
		if now - s.lastScan > 0.12 and s.form > 0.8 then
			s.lastScan = now
			local op = OverlapParams.new()
			op.FilterType = Enum.RaycastFilterType.Exclude
			op.FilterDescendantsInstances = { player.Character, fxFolder }
			local boxCF = hrp.CFrame * CFrame.new(0, 0, -radius * 0.9)
			local found = Workspace:GetPartBoundsInBox(boxCF, Vector3.new(radius * 2.6, height + 2, radius * 1.7), op)
			for _, part in ipairs(found) do
				if not part.Anchored and part.AssemblyLinearVelocity.Magnitude > 22 and now - s.lastHit > 0.2 then
					local m = part:FindFirstAncestorOfClass("Model")
					if not (m and m:FindFirstChildOfClass("Humanoid")) then
						s.lastHit = now
						local rel = hrp.CFrame:PointToObjectSpace(part.Position)
						local h = Vector3.new(rel.X, 0, rel.Z)
						local dirH = h.Magnitude > 0.1 and h.Unit or Vector3.new(0, 0, -1)
						local lp = Vector3.new(dirH.X * radius, math.clamp(rel.Y, -2.5, height - 2.5), dirH.Z * radius)
						local wpos = hrp.CFrame:PointToWorldSpace(lp)
						local normal = hrp.CFrame:VectorToWorldSpace(dirH)
						splash(wpos, normal, 0.8)
						local ang = math.atan2(dirH.X, -dirH.Z)
						local best, bd = nil, 9
						for _, p in ipairs(s.panels) do
							local d = math.abs(p.a - ang)
							if d < bd then
								best, bd = p, d
							end
						end
						if best then
							best.flash = 1
						end
						break
					end
				end
			end
		end
	end)
	UI.refresh()
end

function Shield.stop(instant)
	local s = Shield.sess
	if not s then
		return
	end
	if instant then
		s:End()
		return
	end
	if s.closing then
		return
	end
	s.closing = true
	setBasePose("shield", nil)
	for _, p in ipairs(s.panels) do
		burst(p.glass.Position, 6, { Size = 0.35 })
	end
	animate(s, 0.5, function(a)
		s.dis = a
	end, function()
		s:End()
	end)
	UI.refresh()
end

function Shield.resize(delta)
	Shield.scale = math.clamp(Shield.scale + delta, CONFIG.Shield.MinScale, CONFIG.Shield.MaxScale)
	UI.notify(string.format("Escudo: %.0f%%", Shield.scale * 100))
end

