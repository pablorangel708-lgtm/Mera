-- 7) TIDAL WAVE
-- ===================================================================================
local Tidal = { sess = nil, busy = false }

function Tidal.cast()
	if Tidal.busy then
		return
	end
	local ch = player.Character
	local hrp = getHRP(ch)
	if not (ch and hrp and isAlive(ch)) then
		return
	end
	if not tryUse("TidalWave") then
		return
	end
	local s = newSession()
	Tidal.sess, Tidal.busy = s, true
	s.maid:Give(function()
		if Tidal.sess == s then
			Tidal.sess = nil
			Tidal.busy = false
		end
		UI.refresh()
	end)
	local look = hrp.CFrame.LookVector
	local fwd = Vector3.new(look.X, 0, look.Z)
	fwd = fwd.Magnitude > 0.01 and fwd.Unit or Vector3.new(0, 0, -1)
	local right = fwd:Cross(Vector3.yAxis)
	s.center = hrp.Position + fwd * 10
	s.t0 = os.clock()
	s.phase, s.hmul, s.dis, s.dist = "prep", 0, 0, 0
	s.lastSplash = 0
	local gy0 = groundAt(s.center, 4)
	pulsePose("wave", 2.0)
	UI.notify("Tidal Wave!")
	UI.refresh()

	local gath = {}
	for i = 1, math.max(4, math.floor(9 * Q)) do
		local o = s.maid:Give(orbiter(0.55, 0.5))
		gath[i] = { part = o, a = (i / 9) * math.pi * 2, h = rnd(0.5, 5) }
	end
	local M = CONFIG.Tidal.Columns
	local mid = (M + 1) / 2
	local spacing = 3.4
	local cols = {}
	for i = 1, M do
		local k = (i - mid) / (M / 2)
		local body = s.maid:Give(fxPart({ Size = Vector3.new(spacing * 1.08, 0.2, 3.2), Color = C.Ocean, Transparency = 0.45 }))
		local core = s.maid:Give(fxPart({ Size = Vector3.new(spacing * 0.9, 0.2, 1.2), Color = C.Light, Material = Enum.Material.Neon, Transparency = 0.8 }))
		local foam = s.maid:Give(fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Color = C.Foam, Material = Enum.Material.SmoothPlastic, Transparency = 0.3 }))
		emitter(foam, { Texture = TEX_SMOKE, Size = 2.2, Grow = 1.6, T0 = 0.55, Rate = 12, Speed0 = 2, Speed1 = 7, Life0 = 0.5, Life1 = 1, Light = 0.3, Accel = Vector3.new(0, 2, 0) })
		emitter(body, { Size = 0.4, Rate = 16, Speed0 = 3, Speed1 = 9, Accel = Vector3.new(0, -22, 0), Life0 = 0.5, Life1 = 1 })
		cols[i] = { body = body, core = core, foam = foam, lat = (i - mid) * spacing, prof = 1 - 0.5 * k * k, gy = gy0 }
	end
	ring(Vector3.new(s.center.X, gy0 + 0.15, s.center.Z), 9, nil, C.Turquoise, 1.0)

	addUpdater(s, function(dt)
		local t = os.clock() - s.t0
		if t < 1.0 then
			local f = t
			local gp = s.center + Vector3.new(0, 3, 0)
			for _, g in ipairs(gath) do
				local ang = g.a + t * 7
				local r = lerp(7, 0.4, easeOut(f))
				g.part.CFrame = CFrame.new(gp + Vector3.new(math.cos(ang) * r, g.h * (1 - f * 0.6), math.sin(ang) * r))
			end
		elseif #gath > 0 then
			for _, g in ipairs(gath) do
				g.part:Destroy()
			end
			gath = {}
		end
		if t >= 1.0 and t < 1.8 then
			s.hmul = easeOut((t - 1.0) / 0.8)
		elseif t >= 1.8 and s.phase == "prep" then
			s.phase = "run"
			s.hmul = 1
			shake(1.0, 0.6)
			burst(s.center, 40, { Size = 0.6, Speed0 = 10, Speed1 = 22 })
		end
		if s.phase == "run" then
			local step = CONFIG.Tidal.Speed * dt
			s.center = s.center + fwd * step
			s.dist = s.dist + step
			local hit = Workspace:Raycast(s.center + Vector3.new(0, 4, 0), fwd * 7, ignoreList())
			if (hit and hit.Instance.CanCollide) or s.dist >= CONFIG.Tidal.Distance then
				s.phase = "impact"
				s.impactT = t
				shake(2, 0.6)
				for i, c in ipairs(cols) do
					local pos = s.center + right * c.lat
					burst(pos + Vector3.new(0, 3, 0), 18, { Size = 0.6, Speed0 = 8, Speed1 = 20 })
					if i % 2 == 1 then
						ring(Vector3.new(pos.X, c.gy + 0.15, pos.Z), 6, nil, C.Light, 0.8)
					end
				end
			end
		elseif s.phase == "impact" then
			s.dis = math.clamp((t - s.impactT) / 1.0, 0, 1)
			if os.clock() - s.lastSplash > 0.12 then
				s.lastSplash = os.clock()
				local c = cols[math.random(1, #cols)]
				burst(c.body.Position, 10, { Size = 0.5 })
			end
			if s.dis >= 1 then
				s:End()
				return
			end
		end
		if t >= 0.9 then
			local lean = math.rad(14)
			local hBase = CONFIG.Tidal.Height
			for i, c in ipairs(cols) do
				local pos = s.center + right * c.lat
				local gy = groundAt(pos, 6)
				c.gy = lerp(c.gy, gy, 1 - math.exp(-dt * 12))
				local h = math.max(0.05, hBase * s.hmul * c.prof * (1 + 0.1 * math.sin(t * 5 + i * 0.9)) * (1 - s.dis))
				local gpos = Vector3.new(pos.X, c.gy, pos.Z)
				local baseCF = CFrame.lookAt(gpos, gpos + fwd) * CFrame.Angles(-lean, 0, 0)
				c.body.CFrame = baseCF * CFrame.new(0, h / 2, 0)
				c.body.Size = Vector3.new(spacing * 1.08, h, 3.2)
				c.body.Transparency = lerp(0.42, 1, s.dis)
				c.core.CFrame = baseCF * CFrame.new(0, h / 2, -0.5)
				c.core.Size = Vector3.new(spacing * 0.9, h * 0.92, 1.2)
				c.core.Transparency = lerp(0.78, 1, s.dis)
				c.foam.CFrame = baseCF * CFrame.new(0, h, -0.6)
				c.foam.Size = Vector3.one * math.max(0.1, 3 * math.min(1, h / hBase + 0.2))
				c.foam.Transparency = lerp(0.25, 1, s.dis)
			end
		end
	end)
end

function Tidal.stop()
	local s = Tidal.sess
	if s then
		s:End()
	end
end

