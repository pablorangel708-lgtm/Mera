-- RESPAWN, MORTE E ENCERRAMENTO SEGURO
-- ===================================================================================
local charMaid = Maid.new()
local function onCharacter(ch)
	charMaid:Clean()
	stopAllPowers(true)
	Aura.suspend()
	task.spawn(function()
		local hum = ch:WaitForChild("Humanoid", 10)
		ch:WaitForChild("HumanoidRootPart", 10)
		if ch ~= player.Character or not hum then
			return
		end
		task.wait(0.3)
		if ch ~= player.Character then
			return
		end
		captureMotors(ch)
		charMaid:Give(hum.Died:Connect(function()
			stopAllPowers(true)
			Aura.suspend()
		end))
		if Aura.wanted and CONFIG.AuraPersistAfterRespawn then
			Aura.start()
		end
		UI.refresh()
	end)
end
connections:Give(player.CharacterAdded:Connect(onCharacter))
connections:Give(player.CharacterRemoving:Connect(function()
	stopAllPowers(true)
	Aura.suspend()
	restoreArms()
end))
if player.Character then
	onCharacter(player.Character)
end

local isShuttingDown = false
shutdown = function()
	if isShuttingDown then
		return
	end
	isShuttingDown = true
	pcall(stopAllPowers, true)
	Aura.wanted = false
	pcall(Aura.suspend)
	clearHold()
	Arms.flashTarget, Arms.dyn, Arms.baseTarget, Arms.sway = nil, nil, nil, 0
	pcall(restoreArms)
	charMaid:Clean()
	if targetConn then
		targetConn:Disconnect()
	end
	if shakeBound then
		pcall(function()
			RunService:UnbindFromRenderStep("MeraShake")
		end)
		shakeBound = false
	end
	connections:Clean()
	if gui then
		gui:Destroy()
	end
	fxFolder:Destroy()
end
script.Destroying:Connect(shutdown)

