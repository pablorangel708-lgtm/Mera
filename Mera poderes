-- ===================================================================================
local Whirl = { sess = nil, intensity = 1 }

function Whirl.start()
	if Whirl.sess then
		return
	end
	local tp, tch, thrp = Target.get()
	if not tp then
		UI.notify("Selecione um alvo na lista primeiro.")
		return
	end
	local s = newSession()
	Whirl.sess = s
	s.target, s.tchar = tp, tch
	s.pos = thrp.Position
	s.t0 = os.clock()
	s.form, s.dis = 0, 0
	s.R = CONFIG.Whirlpool.Radius
	s.maid:Give(function()
		if Whirl.sess == s then
			Whirl.sess = nil
		end
		UI.refresh()
	end)
	local disc = s.maid:Give(fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 1, 1), Color = C.Ocean, Transparency = 1 }))
	local disc2 = s.maid:Give(fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1, 1), Color = C.Turquoise, Material = Enum.Material.ForceField, Transparency = 1 }))
	local foam = emitter(disc, { Texture = TEX_SMOKE, Size = 2.4, T0 = 0.5, Rate = 30, Speed0 = 1, Speed1 = 4, Life0 = 0.5, Life1 = 1, Light = 0.3, Color0 = C.Foam, Color1 = C.Light, Shape = Enum.ParticleEmitterShape.Cylinder })
	emitter(disc, { Size = 0.35, Rate = 25, Speed0 = 3, Speed1 = 9, Accel = Vector3.new(0, -18, 0), Life0 = 0.5, Life1 = 1, Shape = Enum.ParticleEmitterShape.Cylinder })
	local per = math.max(3, math.floor(7 * Q + 0.5))
	local orbs = {}
	for l = 1, 3 do
		for i = 1, per do
			local o = s.maid:Give(orbiter(0.5, 0.55))
			table.insert(orbs, { part = o, l = l, a = (i / per) * math.pi * 2 + l, spd = 3.5 * (1 + l * 0.2) })
		end
	end
	burst(s.pos, 40, { Size = 0.5 })
	animate(s, 0.8, function(a)
		s.form = easeOut(a)
	end)
	UI.notify("Whirlpool ativado.")

	addUpdater(s, function(dt)
		local t = os.clock() - s.t0
		if not s.closing then
			local tch2, thrp2 = Target.validate(s.target, s.tchar)
			if not tch2 then
				Whirl.stop(false, "Alvo perdido: redemoinho encerrado.")
				return
			end
			s.pos = s.pos:Lerp(thrp2.Position, 1 - math.exp(-dt * 10))
		end
		local gy = groundAt(s.pos, 2)
		local base = Vector3.new(s.pos.X, gy + 0.15, s.pos.Z)
		local fade = s.form * (1 - s.dis)
		local inten = Whirl.intensity
		local d = s.R * 2 * (0.85 + 0.15 * math.sin(t * 2)) * fade
		disc.CFrame = CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90))
		disc.Size = Vector3.new(0.25, math.max(d, 0.2), math.max(d, 0.2))
		disc.Transparency = 1 - 0.55 * fade
		disc2.CFrame = disc.CFrame
		disc2.Size = Vector3.new(0.35, math.max(d * 0.8, 0.2), math.max(d * 0.8, 0.2))
		disc2.Transparency = 1 - 0.5 * fade
		foam.Rate = 30 * inten * Q * fade
		for _, o in ipairs(orbs) do
			local ang = o.a + t * o.spd * inten
			local r = s.R * (0.4 + 0.22 * o.l) * fade * (1 + 0.06 * math.sin(t * 2 + o.a))
			local y = 0.5 + (o.l - 1) * 2.6 + 0.5 * math.sin(t * 3 + o.a)
			o.part.CFrame = CFrame.new(base + Vector3.new(math.cos(ang) * r, y, math.sin(ang) * r))
			o.part.Transparency = 1 - 0.75 * fade
		end
	end)
	UI.refresh()
end

function Whirl.stop(instant, msg)
	local s = Whirl.sess
	if not s then
		return
	end
	if msg then
		UI.notify(msg)
	end
	if instant then
		s:End()
		return
	end
	if s.closing then
		return
	end
	s.closing = true
	burst(s.pos, 40, { Size = 0.5 })
	animate(s, 0.6, function(a)
		s.dis = a
	end, function()
		s:End()
	end)
	UI.refresh()
end

function Whirl.adjust(delta)
	Whirl.intensity = math.clamp(Whirl.intensity + delta, CONFIG.Whirlpool.MinIntensity, CONFIG.Whirlpool.MaxIntensity)
	UI.notify(string.format("Intensidade: %.0f%%", Whirl.intensity * 100))
end

