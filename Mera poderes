local PowerUI = {}
local function powerRow(key, icon, title, onPress)
	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextLO() }, scroll)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
	local b = new("TextButton", { Size = UDim2.new(1, 0, 0, 42), Text = "", LayoutOrder = 1 }, holder)
	styleBtn(b)
	new("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(40, 42), Text = icon, TextSize = 22, Font = Enum.Font.GothamBold }, b)
	new("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(40, 0), Size = UDim2.new(1, -70, 1, 0), Text = title,
		TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Foam, Font = Enum.Font.GothamMedium, TextSize = 14,
	}, b)
	local dot = new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = Color3.fromRGB(60, 80, 110), BorderSizePixel = 0,
	}, b)
	corner(dot, 6)
	local sub = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, LayoutOrder = 2 }, holder)
	new("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }, sub)
	new("UIPadding", { PaddingLeft = UDim.new(0, 4) }, sub)
	b.Activated:Connect(onPress)
	PowerUI[key] = { btn = b, dot = dot, sub = sub }
	return sub
end

