local function getHum(ch)
	return ch and ch:FindFirstChildOfClass("Humanoid")
end
local function getHRP(ch)
	ch = ch or player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart")
end
local function isAlive(ch)
	local h = getHum(ch)
	return h ~= nil and h.Health > 0 and getHRP(ch) ~= nil
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true
local function ignoreList()
	local list = { fxFolder }
	if player.Character then
		table.insert(list, player.Character)
	end
	rayParams.FilterDescendantsInstances = list
	return rayParams
end
local function groundAt(pos, from)
	local r = Workspace:Raycast(pos + Vector3.new(0, from or 4, 0), Vector3.new(0, -300, 0), ignoreList())
	if r then
		return r.Position.Y, r.Normal
	end
	return pos.Y - 3, Vector3.yAxis
end

-- Cooldowns
local lastUse = {}
local function tryUse(name, silent)
	local cd = CONFIG.Cooldowns[name] or 0
	local last = lastUse[name]
	local now = os.clock()
	if last and now - last < cd then
		if not silent and cd >= 1.5 then
			UI.notify(string.format("Em recarga: %.1fs", cd - (now - last)))
		end
		return false
	end
	lastUse[name] = now
	return true
end

-- Rotinas de tempo
local function swait(s, d)
	local t0 = os.clock()
	while s.alive and os.clock() - t0 < d do
		RunService.Heartbeat:Wait()
	end
	return s.alive
end
local function animate(s, dur, fn, done)
	task.spawn(function()
		local t0 = os.clock()
		while true do
			if s and not s.alive then
				return
			end
			local a = math.clamp((os.clock() - t0) / dur, 0, 1)
			fn(a)
			if a >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		if done then
			done()
		end
	end)
end

-- Loop mestre: um único RenderStepped para todos os poderes
local updaters = {}
local function addUpdater(sess, fn)
	local u = { fn = fn, dead = false }
	table.insert(updaters, u)
	sess.maid:Give(function()
		u.dead = true
		local i = table.find(updaters, u)
		if i then
			table.remove(updaters, i)
		end
	end)
end
connections:Give(RunService.RenderStepped:Connect(function(dt)
	local snap = table.clone(updaters)
	for _, u in ipairs(snap) do
		if not u.dead then
			local ok, err = pcall(u.fn, dt)
			if not ok then
				u.dead = true
				warn("[Mera] " .. tostring(err))
			end
		end
	end
end))

-- Tremor de câmera
local shakeUntil, shakeMag, shakeBound = 0, 0, false
local function shake(mag, dur)
	shakeMag = math.max(shakeMag * 0.5, mag)
	shakeUntil = os.clock() + dur
	if shakeBound then
		return
	end
	shakeBound = true
	RunService:BindToRenderStep("MeraShake", Enum.RenderPriority.Camera.Value + 1, function()
		local rem = shakeUntil - os.clock()
		if rem <= 0 then
			RunService:UnbindFromRenderStep("MeraShake")
			shakeBound = false
			shakeMag = 0
			return
		end
		local cam = Workspace.CurrentCamera
		local m = shakeMag * math.min(rem, 1) * 0.05
		cam.CFrame = cam.CFrame * CFrame.Angles((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0)
	end)
end

