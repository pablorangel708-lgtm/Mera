-- 1) WATER PRISON + 2) HYDROKINESIS
-- ===================================================================================
local Prison = { sess = nil }

local function setCharHidden(ch, hide)
	for _, d in ipairs(ch:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = hide and 1 or 0
		end
	end
end

local function makeGhost(ch)
	local ok, clone = pcall(function()
		return ch:Clone()
	end)
	if not ok or not clone then
		return nil
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BaseScript") or d:IsA("Sound") or d:IsA("Highlight") or d:IsA("ForceField") or d:IsA("BillboardGui") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
			d.LocalTransparencyModifier = 0
		elseif d:IsA("Humanoid") then
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		end
	end
	clone.Name = "MeraGhost"
	clone.Parent = fxFolder
	return clone
end

local function leaveControl(s)
	if s.ctl then
		s.ctl:Clean()
		s.ctl = nil
	end
	clearHold()
	Arms.dyn = nil
	Arms.sway = 0
end

function Prison.start()
	if Prison.sess then
		return
	end
	local ch = player.Character
	if not (ch and isAlive(ch)) then
		return
	end
	local tp, tch, thrp = Target.get()
	if not tp then
		UI.notify("Selecione um alvo na lista primeiro.")
		return
	end
	if not tryUse("Prison") then
		return
	end
	local R = CONFIG.Prison.Radius
	local s = newSession()
	Prison.sess = s
	s.target, s.tchar = tp, tch
	s.pos, s.vel = thrp.Position, Vector3.zero
	s.thrp = thrp
	s.scale, s.dis = 0, 0
	s.mode = "track" -- track | control | return
	s.hover, s.carry = false, false
	s.offset = Vector3.new(0, 4, 18)
	s.t0 = os.clock()
	s.lastRipple = 0
	s.maid:Give(function()
		if Prison.sess == s then
			Prison.sess = nil
		end
		if s.hidden and s.tchar then
			pcall(setCharHidden, s.tchar, false)
		end
		if s.ghost then
			s.ghost:Destroy()
		end
		clearHold()
		Arms.dyn = nil
		Arms.sway = 0
		UI.refresh()
	end)

	local sphere = s.maid:Give(fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Color = C.Ocean, Transparency = 1, Reflectance = 0.15 }))
	local shell = s.maid:Give(fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Material = Enum.Material.ForceField, Color = C.Turquoise, Transparency = 1 }))
	local core = s.maid:Give(fxPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Material = Enum.Material.Neon, Color = C.Light, Transparency = 1 }))
	local disc = s.maid:Give(fxPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 1, 1), Material = Enum.Material.Neon, Color = C.Turquoise, Transparency = 1 }))
	new("PointLight", { Color = C.Turquoise, Brightness = 1.3, Range = 16 }, sphere)
	emitter(core, { Size = 0.35, Rate = 16, Speed0 = 0.3, Speed1 = 1.4, Life0 = 1, Life1 = 2, Accel = Vector3.new(0, 1.2, 0), Shape = Enum.ParticleEmitterShape.Sphere })
	emitter(core, { Texture = TEX_SMOKE, Size = 1.6, T0 = 0.7, Rate = 4, Speed0 = 0.2, Speed1 = 0.8, Life0 = 1.2, Life1 = 2, Light = 0.4, Shape = Enum.ParticleEmitterShape.Sphere, Color0 = C.Light, Color1 = C.Ocean })
	local wake = emitter(sphere, { Texture = TEX_SMOKE, Size = 3, T0 = 0.5, Rate = 0, Enabled = true, Speed0 = 1, Speed1 = 4, Life0 = 0.5, Life1 = 0.9, Light = 0.3, Color0 = C.Foam, Color1 = C.Light })

	local orbs = {}
	local n = math.max(3, math.floor(7 * Q + 0.5))
	for i = 1, n do
		local o = s.maid:Give(orbiter(0.45, 0.5))
		orbs[i] = { part = o, a = (i / n) * math.pi * 2, spd = 1.4 + (i % 3) * 0.5, tx = math.rad(20 + i * 23), ty = math.rad(i * 51), rad = 0.82 + (i % 2) * 0.1 }
	end

	burst(s.pos, 50, { Size = 0.5, Speed0 = 10, Speed1 = 22 })
	ring(s.pos - Vector3.new(0, 2.6, 0), R * 1.2, nil, C.Light, 0.8)
	animate(s, 0.9, function(a)
		s.scale = easeOutBack(a)
	end)
	UI.notify("Water Prison ativada.")

	addUpdater(s, function(dt)
		local t = os.clock() - s.t0
		local mhrp = getHRP()
		if not mhrp then
			s:End()
			return
		end
		if not s.closing then
			local tch2, thrp2 = Target.validate(s.target, s.tchar)
			if not tch2 then
				Prison.stop(false, "Alvo perdido: prisão desfeita.")
				return
			end
			s.thrp = thrp2
		end
		local speed = 0
		local fade = math.clamp(s.scale, 0, 1) * (1 - s.dis)
		local sc = s.scale * (1 + s.dis * 0.18)

		if s.closing then
			-- parada: mantém posição
		elseif s.mode == "track" then
			local old = s.pos
			s.pos = s.pos:Lerp(s.thrp.Position, 1 - math.exp(-dt * 12))
			speed = (s.pos - old).Magnitude / math.max(dt, 1e-3)
		elseif s.mode == "return" then
			local goal = s.thrp.Position
			local old = s.pos
			s.pos = s.pos:Lerp(goal, 1 - math.exp(-dt * 4))
			speed = (s.pos - old).Magnitude / math.max(dt, 1e-3)
			if (s.pos - goal).Magnitude < 1.4 then
				s.mode = "track"
				if s.ghost then
					s.ghost:Destroy()
					s.ghost = nil
				end
				if s.hidden then
					setCharHidden(s.tchar, false)
					s.hidden = false
				end
				UI.refresh()
			end
		elseif s.mode == "control" then
			local hy = (Hold.up and 1 or 0) - (Hold.down and 1 or 0)
			local hx = (Hold.right and 1 or 0) - (Hold.left and 1 or 0)
			local hz = (Hold.far and 1 or 0) - (Hold.near and 1 or 0)
			local cam = Workspace.CurrentCamera
			local lv = cam.CFrame.LookVector
			local flat = Vector3.new(lv.X, 0, lv.Z)
			flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
			local right = flat:Cross(Vector3.yAxis)
			local spd = CONFIG.Prison.MoveSpeed
			local mpos = mhrp.Position
			if s.hover then
				hy = 0
			end
			if s.carry then
				s.offset = s.offset + Vector3.new(hx * spd * 0.7 * dt, hy * spd * 0.6 * dt, hz * spd * 0.7 * dt)
				s.offset = Vector3.new(math.clamp(s.offset.X, -45, 45), math.clamp(s.offset.Y, -3, 40), math.clamp(s.offset.Z, -45, 60))
				local goal = mpos + right * s.offset.X + Vector3.yAxis * s.offset.Y + flat * s.offset.Z
				local old = s.pos
				s.pos = s.pos:Lerp(goal, 1 - math.exp(-dt * 6))
				s.vel = (s.pos - old) / math.max(dt, 1e-3)
			else
				local away = Vector3.new(s.pos.X - mpos.X, 0, s.pos.Z - mpos.Z)
				away = away.Magnitude > 0.5 and away.Unit or flat
				local want = right * hx * spd + Vector3.yAxis * hy * spd * 0.8 + away * hz * spd
				s.vel = s.vel:Lerp(want, 1 - math.exp(-dt * 5))
				s.pos = s.pos + s.vel * dt
			end
			local off = s.pos - mpos
			if off.Magnitude > CONFIG.Prison.MaxDistance then
				s.pos = mpos + off.Unit * CONFIG.Prison.MaxDistance
			end
			local gy = groundAt(s.pos, 2)
			if s.hover then
				local want = math.max(s.pos.Y, gy + CONFIG.Prison.HoverHeight)
				s.pos = Vector3.new(s.pos.X, lerp(s.pos.Y, want, 1 - math.exp(-dt * 3)), s.pos.Z)
			elseif s.pos.Y < gy + 3.5 then
				s.pos = Vector3.new(s.pos.X, gy + 3.5, s.pos.Z)
			end
			speed = s.vel.Magnitude
			-- levitação: disco de água no chão + ondulações
			local height = s.pos.Y - gy
			if height > 5 then
				local d = R * 2 * (1 - math.clamp((height - 5) / 50, 0, 0.55)) * fade
				disc.Size = Vector3.new(0.12, math.max(d, 0.2), math.max(d, 0.2))
				disc.CFrame = CFrame.new(s.pos.X, gy + 0.12, s.pos.Z) * CFrame.Angles(0, 0, math.rad(90))
				disc.Transparency = 0.55 + math.clamp((height - 5) / 60, 0, 0.35)
				if os.clock() - s.lastRipple > 0.7 then
					s.lastRipple = os.clock()
					ring(Vector3.new(s.pos.X, gy + 0.15, s.pos.Z), d * 0.5, nil, C.Turquoise, 0.8)
				end
			else
				disc.Transparency = 1
			end
			-- mãos e braços acompanham o comando
			Arms.dyn = { 86 + hy * 34 + hz * 8, 14 + math.abs(hx) * 10, 86 + hy * 34 + hz * 8, 14 + math.abs(hx) * 10 }
			Arms.sway = 3.5
		end
		if s.mode ~= "control" then
			disc.Transparency = 1
		end

		-- visual da esfera
		local bob = math.sin(t * 2) * ((s.hover and s.mode == "control") and 0.5 or 0.25)
		local center = s.pos + Vector3.new(0, bob, 0)
		local diameter = R * 2 * math.max(sc, 0.01)
		sphere.CFrame = CFrame.new(center) * CFrame.Angles(0, t * 0.3, 0)
		sphere.Size = Vector3.one * diameter
		sphere.Transparency = 1 - 0.38 * fade - 0.03 * math.sin(t * 2) * fade
		shell.CFrame = sphere.CFrame
		shell.Size = Vector3.one * diameter * 1.02
		shell.Transparency = 1 - 0.45 * fade
		core.CFrame = sphere.CFrame
		core.Size = Vector3.one * diameter * 0.94
		core.Transparency = 1 - 0.1 * fade
		wake.Rate = math.clamp(speed * 0.9, 0, 28) * Q
		for _, o in ipairs(orbs) do
			local ang = o.a + t * o.spd * (1 + math.min(speed, 40) * 0.04)
			local rad = R * sc * o.rad
			o.part.CFrame = CFrame.new(center) * CFrame.Angles(o.tx, o.ty, 0) * CFrame.new(math.cos(ang) * rad, 0, math.sin(ang) * rad)
			o.part.Transparency = 1 - 0.75 * fade
		end
		if s.ghost then
			s.ghost:PivotTo(CFrame.new(center) * CFrame.Angles(0, t * 0.6, 0) * CFrame.Angles(math.sin(t * 1.3) * 0.06, 0, math.sin(t * 0.9) * 0.06))
		end
		-- correntes de água ligando as mãos à esfera
		if s.hb and s.mode == "control" then
			for side, h in pairs(s.hb) do
				local hp = handPos(side)
				if hp then
					h.a0.WorldPosition = hp
					local dir = hp - center
					h.a1.WorldPosition = center + (dir.Magnitude > 0.1 and dir.Unit or Vector3.yAxis) * (R * sc * 0.92)
				end
			end
		end
	end)
	UI.refresh()
end

function Prison.beginControl()
	local s = Prison.sess
	if not s or s.closing then
		UI.notify("Ative a Water Prison primeiro.")
		return false
	end
	if s.mode == "control" then
		return true
	end
	s.mode = "control"
	s.vel = Vector3.zero
	if CONFIG.Prison.UseGhostDouble and not s.ghost then
		s.ghost = makeGhost(s.tchar)
		if s.ghost then
			setCharHidden(s.tchar, true)
			s.hidden = true
		else
			UI.notify("Não foi possível clonar o alvo; só a esfera se move.")
		end
	end
	local ctl = Maid.new()
	s.ctl = ctl
	s.hb = {}
	for _, side in ipairs({ "R", "L" }) do
		local a0 = new("Attachment", nil, Workspace.Terrain)
		local a1 = new("Attachment", nil, Workspace.Terrain)
		ctl:Give(a0)
		ctl:Give(a1)
		local beam = new("Beam", {
			Attachment0 = a0, Attachment1 = a1, Width0 = 0.5, Width1 = 0.9, CurveSize0 = 3, CurveSize1 = -3, Segments = 14,
			FaceCamera = true, LightEmission = 0.6, Color = ColorSequence.new(C.Foam, C.Turquoise),
			Transparency = NumberSequence.new(0.35),
		}, fxFolder)
		ctl:Give(beam)
		ctl:Give(emitter(a0, { Size = 0.3, Rate = 22, Speed0 = 1, Speed1 = 3, Life0 = 0.4, Life1 = 0.8, Accel = Vector3.new(0, 2, 0) }))
		s.hb[side] = { a0 = a0, a1 = a1 }
	end
	ctl:Give(function()
		s.hb = nil
	end)
	pulsePose("summon", 0.7)
	UI.notify("Hydrokinesis: controle manual ativo.")
	UI.refresh()
	return true
end

function Prison.endControl()
	local s = Prison.sess
	if not s or s.mode ~= "control" then
		return
	end
	leaveControl(s)
	s.hover, s.carry = false, false
	s.mode = s.ghost and "return" or "track"
	UI.notify("Controle encerrado: a esfera volta ao alvo.")
	UI.refresh()
end

function Prison.haltMotion()
	local s = Prison.sess
	if not s then
		return
	end
	s.vel = Vector3.zero
	s.carry = false
	clearHold()
	UI.refresh()
end

function Prison.toggleHover()
	local s = Prison.sess
	if s and s.mode == "control" then
		s.hover = not s.hover
		UI.refresh()
	end
end

function Prison.toggleCarry()
	local s = Prison.sess
	if not (s and s.mode == "control") then
		return
	end
	local mhrp = getHRP()
	if not mhrp then
		return
	end
	s.carry = not s.carry
	if s.carry then
		local cam = Workspace.CurrentCamera
		local lv = cam.CFrame.LookVector
		local flat = Vector3.new(lv.X, 0, lv.Z)
		flat = flat.Magnitude > 0.01 and flat.Unit or Vector3.new(0, 0, -1)
		local right = flat:Cross(Vector3.yAxis)
		local rel = s.pos - mhrp.Position
		s.offset = Vector3.new(rel:Dot(right), rel.Y, rel:Dot(flat))
	end
	UI.refresh()
end

function Prison.stop(instant, msg)
	local s = Prison.sess
	if not s then
		return
	end
	if msg then
		UI.notify(msg)
	end
	if instant then
		s:End()
		return
	end
	if s.closing then
		return
	end
	s.closing = true
	leaveControl(s)
	burst(s.pos, 70, { Size = 0.6, Speed0 = 10, Speed1 = 26 })
	ring(s.pos, CONFIG.Prison.Radius * 1.3, nil, C.Light, 0.7)
	animate(s, 0.6, function(a)
		s.dis = a
	end, function()
		s:End()
	end)
	UI.refresh()
end

