-- Atualização geral da interface
function UI.refresh()
	if not gui or not gui.Parent then
		return
	end
	local names = {}
	local function set(key, on, label, showSub)
		local u = PowerUI[key]
		if not u then
			return
		end
		setBtnState(u.btn, on)
		u.dot.BackgroundColor3 = on and C.Turquoise or Color3.fromRGB(60, 80, 110)
		u.sub.Visible = showSub and true or false
		if on then
			table.insert(names, label)
		end
	end
	local ps = Prison.sess
	local ctl = ps ~= nil and ps.mode == "control" and not ps.closing
	set("prison", ps ~= nil, "Prison", ps ~= nil)
	set("hydro", ctl, "Hydrokinesis", ctl)
	set("whip", Whip.sess ~= nil, "Whip", Whip.sess ~= nil)
	set("blast", Blast.armed, "Blast", Blast.armed)
	set("constructs", Constructs.armed, "Constructs", Constructs.armed)
	set("shield", Shield.sess ~= nil, "Shield", Shield.sess ~= nil)
	set("tidal", Tidal.busy, "Tidal Wave", false)
	set("whirl", Whirl.sess ~= nil, "Whirlpool", Whirl.sess ~= nil)
	set("aura", Aura.sess ~= nil, "Aura", Aura.sess ~= nil)
	activeLbl.Text = "Ativo: " .. (#names > 0 and table.concat(names, " · ") or "—")
	local tp = Target.player
	if tp then
		local ok = Target.get() ~= nil
		targetLbl.Text = "Alvo: " .. tp.DisplayName .. (ok and "" or " (indisponível)")
	else
		targetLbl.Text = "Alvo: —"
	end
	for p, b in pairs(rows) do
		setBtnState(b, Target.player == p)
	end
	setBtnState(hoverBtn, ps ~= nil and ps.hover == true)
	setBtnState(carryBtn, ps ~= nil and ps.carry == true)
	setBtnState(boltBtn, Blast.mode == "bolt")
	setBtnState(jetBtn, Blast.mode == "jet")
	local k = Constructs.sess and not Constructs.sess.closing and Constructs.sess.kind or nil
	setBtnState(swordBtn, k == "sword")
	setBtnState(spearBtn, k == "spear")
	setBtnState(tridentBtn, k == "trident")
end

-- Abrir/fechar, posicionar e arrastar o painel
local panelOpen = false
local function panelSize()
	local v = viewport()
	return Vector2.new(math.min(318, v.X - 16), math.min(480, v.Y - 24))
end
local function placePanel()
	local ps = panelSize()
	local v = viewport()
	panel.Size = UDim2.fromOffset(ps.X, ps.Y)
	local fx, fy = float.Position.X.Offset, float.Position.Y.Offset
	local x = math.clamp(fx + 56 - ps.X, 8, v.X - ps.X - 8)
	local y
	if fy + 62 + ps.Y <= v.Y - 8 then
		y = fy + 62
	else
		y = math.clamp(fy - ps.Y - 6, 8, v.Y - ps.Y - 8)
	end
	panel.Position = UDim2.fromOffset(x, y)
end
local function setPanel(open)
	panelOpen = open
	if open then
		placePanel()
		panel.Visible = true
		tw(panel, 0.25, { GroupTransparency = 0 })
		tw(panelScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		UI.refresh()
	else
		tw(panel, 0.2, { GroupTransparency = 1 })
		tw(panelScale, 0.2, { Scale = 0.9 })
		task.delay(0.22, function()
			if not panelOpen and panel.Parent then
				panel.Visible = false
			end
		end)
	end
end
closeBtn.Activated:Connect(function()
	setPanel(false)
end)

local dragging, dragInput, dragStart, startPos, dragged = false, nil, nil, nil, false
float.InputBegan:Connect(function(input)
	if isPress(input) then
		dragging, dragged = true, false
		dragStart = input.Position
		startPos = Vector2.new(float.Position.X.Offset, float.Position.Y.Offset)
		local c
		c = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				c:Disconnect()
				dragging = false
				if not dragged then
					setPanel(not panelOpen)
				end
			end
		end)
	end
end)
float.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)
connections:Give(UserInputService.InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		local delta = input.Position - dragStart
		if delta.Magnitude > 8 then
			dragged = true
		end
		if dragged then
			local v = viewport()
			local nx = math.clamp(startPos.X + delta.X, 4, v.X - 60)
			local ny = math.clamp(startPos.Y + delta.Y, 4, v.Y - 60)
			float.Position = UDim2.fromOffset(nx, ny)
			if panelOpen then
				placePanel()
			end
		end
	end
end))

