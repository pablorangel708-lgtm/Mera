local targetConn
local function refreshTargetMarker()
	local p = Target.player
	local ch = p and p.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	targetHighlight.Adornee = ch
	targetHighlight.Enabled = ch ~= nil
	targetTag.Adornee = hrp
	targetTag.Enabled = hrp ~= nil
end

function Target.set(p)
	if p == player then
		return
	end
	if targetConn then
		targetConn:Disconnect()
		targetConn = nil
	end
	Target.player = p
	if p then
		targetConn = p.CharacterAdded:Connect(function()
			task.wait(0.3)
			refreshTargetMarker()
			UI.refresh()
		end)
	end
	refreshTargetMarker()
	UI.refresh()
end

function Target.validate(p, expectedChar)
	if not p or p.Parent ~= Players then
		return nil
	end
	local ch = p.Character
	if not ch or (expectedChar and ch ~= expectedChar) then
		return nil
	end
	local hrp = ch:FindFirstChild("HumanoidRootPart")
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hrp and hum and hum.Health > 0 then
		return ch, hrp
	end
	return nil
end

function Target.get()
	local ch, hrp = Target.validate(Target.player)
	if ch then
		return Target.player, ch, hrp
	end
	return nil
end

local function getAimPos(maxDist)
	local _, _, thrp = Target.get()
	if thrp then
		return thrp.Position
	end
	local cam = Workspace.CurrentCamera
	local r = Workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * maxDist, ignoreList())
	return r and r.Position or (cam.CFrame.Position + cam.CFrame.LookVector * maxDist)
end

-- ===================================================================================
-- ANIMAÇÕES DOS BRAÇOS (poses procedurais nos ombros — sem IDs de animação)
-- ===================================================================================
-- Cada pose: { pitchD, rollD, pitchE, rollE } em graus.
-- pitch>0 levanta o braço para frente; roll>0 abre o braço para o lado; roll<0 cruza.
local POSES = {
	idle = { 0, 0, 0, 0 },
	summon = { 70, 30, 70, 30 },
	extend = { 88, 14, 88, 14 },
	push = { 92, 4, 92, 4 },
	whip = { 100, 32, 45, 18 },
	whipWind = { 150, 30, 150, 30 },
	whipPull = { 70, 10, 70, 10 },
	shield = { 85, -22, 85, -22 },
	wave = { 165, 25, 165, 25 },
	focus = { 35, 40, 35, 40 },
	hold = { 50, 18, 20, 6 },
	slash = { 130, 10, 40, 10 },
	thrust = { 95, 5, 60, 10 },
}

local Arms = { motors = {}, orig = {}, cur = { 0, 0, 0, 0 }, baseTarget = nil, flashTarget = nil, dyn = nil, sway = 0, rest = true }

local function restoreArms()
	local m, o = Arms.motors, Arms.orig
	if m.R and m.R.Parent and o.R then
		m.R.C0 = o.R
	end
	if m.L and m.L.Parent and o.L then
		m.L.C0 = o.L
	end
	Arms.cur = { 0, 0, 0, 0 }
	Arms.rest = true
end

local function captureMotors(ch)
	Arms.motors = {}
	Arms.orig = {}
	Arms.cur = { 0, 0, 0, 0 }
	Arms.rest = true
	local hum = getHum(ch)
	if not hum then
		return
	end
	if hum.RigType == Enum.HumanoidRigType.R15 then
		local r = ch:WaitForChild("RightUpperArm", 3)
		local l = ch:WaitForChild("LeftUpperArm", 3)
		Arms.motors.R = r and r:FindFirstChild("RightShoulder")
		Arms.motors.L = l and l:FindFirstChild("LeftShoulder")
	else
		local t = ch:WaitForChild("Torso", 3)
		Arms.motors.R = t and t:FindFirstChild("Right Shoulder")
		Arms.motors.L = t and t:FindFirstChild("Left Shoulder")
	end
	Arms.orig.R = Arms.motors.R and Arms.motors.R.C0
	Arms.orig.L = Arms.motors.L and Arms.motors.L.C0
end

local function pivotC0(c0, pitch, roll, sign)
	local pos = c0.Position
	local rot = CFrame.Angles(math.rad(pitch), 0, math.rad(roll * sign))
	return CFrame.new(pos) * rot * CFrame.new(-pos) * c0
end

connections:Give(RunService.RenderStepped:Connect(function(dt)
	local m, o = Arms.motors, Arms.orig
	if not (m.R and m.L and o.R and o.L) or not m.R.Parent or not m.L.Parent then
		return
	end
	local t = Arms.flashTarget or Arms.dyn or Arms.baseTarget or POSES.idle
	local idle = (t == POSES.idle)
	local k = 1 - math.exp(-dt * 12)
	local moving = false
	for i = 1, 4 do
		local d = t[i] - Arms.cur[i]
		if math.abs(d) > 0.05 then
			moving = true
		end
		Arms.cur[i] = Arms.cur[i] + d * k
	end
	local swayAmt = Arms.sway + (idle and 0 or 1.2)
	if not moving and idle and swayAmt == 0 then
		if not Arms.rest then
			restoreArms()
		end
		return
	end
	Arms.rest = false
	local sw = math.sin(os.clock() * 2.2) * swayAmt
	m.R.C0 = pivotC0(o.R, Arms.cur[1] + sw, Arms.cur[2] + sw * 0.5, 1)
	m.L.C0 = pivotC0(o.L, Arms.cur[3] - sw, Arms.cur[4] + sw * 0.5, -1)
end))

local baseKeys = {}
local BASE_PRIORITY = { "blast", "whip", "shield", "weapon" }
local function setBasePose(key, pose)
	baseKeys[key] = pose
	Arms.baseTarget = nil
	for _, k in ipairs(BASE_PRIORITY) do
		if baseKeys[k] then
			Arms.baseTarget = POSES[baseKeys[k]]
			break
		end
	end
end
local flashToken = 0
local function pulsePose(name, dur)
	flashToken = flashToken + 1
	local my = flashToken
	Arms.flashTarget = POSES[name]
	task.delay(dur, function()
		if flashToken == my then
			Arms.flashTarget = nil
		end
	end)
end

local function handPart(side)
	local ch = player.Character
	if not ch then
		return nil
	end
	if side == "R" then
		return ch:FindFirstChild("RightHand") or ch:FindFirstChild("Right Arm")
	end
	return ch:FindFirstChild("LeftHand") or ch:FindFirstChild("Left Arm")
end
local function handPos(side)
	local p = handPart(side)
	if not p then
		return nil
	end
	if p.Name:find("Arm") then
		return (p.CFrame * CFrame.new(0, -p.Size.Y / 2 + 0.2, 0)).Position
	end
	return p.Position
end

-- Estado dos botões de segurar (controle manual da esfera)
local Hold = { up = false, down = false, left = false, right = false, near = false, far = false }
local function clearHold()
	for k in pairs(Hold) do
		Hold[k] = false
	end
end

